# Environment
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/file-upload

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
AWS_CLOUDFRONT_DISTRIBUTION=your-cloudfront-distribution-id

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRE=7d

# File Upload
MAX_FILE_SIZE=104857600
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,video/mp4,audio/mpeg

# Features
ENABLE_VIRUS_SCAN=true
ENABLE_IMAGE_PROCESSING=true
ENABLE_CHUNKED_UPLOAD=true

# CDN
CDN_URL=https://your-cdn-domain.com

# Encryption
ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# Integrations
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
DROPBOX_ACCESS_TOKEN=your-dropbox-access-token
GOOGLE_DRIVE_ACCESS_TOKEN=your-google-drive-access-token

# ClamAV
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Multi-cloud Support
CLOUD_PROVIDER=aws
DIGITALOCEAN_SPACES_KEY=your-do-spaces-key
DIGITALOCEAN_SPACES_SECRET=your-do-spaces-secret
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
