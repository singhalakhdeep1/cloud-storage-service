{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "moduleResolution": "node",
        "lib": ["ES2022", "DOM"],
        "outDir": "dist",
        "rootDir": ".",
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "sourceMap": true,
        "types": ["node", "jest"]
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules", "dist", "coverage", "tests", "frontend", "jest.setup.ts"]
}
