{
    "name": "cloud-storage-service",
    "version": "2.0.0",
    "description": "Cloud storage service: multi-provider object storage (local, S3, MinIO, DigitalOcean, Wasabi, R2, Backblaze, GCS, Azure), resumable uploads, versions, sharing, image processing, virus scanning, encryption at rest (TypeScript)",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "jest --coverage",
        "test:watch": "jest --watch"
    },
    "keywords": [
        "file-upload",
        "s3",
        "object-storage",
        "multer",
        "streaming"
    ],
    "author": "",
    "license": "Proprietary",
    "dependencies": {
        "@aws-sdk/client-cloudfront": "^3.600.0",
        "@aws-sdk/client-s3": "^3.600.0",
        "@aws-sdk/lib-storage": "^3.600.0",
        "@aws-sdk/s3-request-presigner": "^3.600.0",
        "@azure/storage-blob": "^12.17.0",
        "@google-cloud/storage": "^7.7.0",
        "axios": "^1.6.2",
        "bcryptjs": "^2.4.3",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "file-type": "^16.5.4",
        "helmet": "^7.0.0",
        "ioredis": "^5.4.1",
        "joi": "^17.11.0",
        "jsonwebtoken": "^9.0.2",
        "mime-types": "^2.1.35",
        "mongoose": "^8.0.0",
        "multer": "^2.0.2",
        "sharp": "^0.33.5",
        "swagger-ui-express": "^5.0.0",
        "winston": "^3.11.0",
        "winston-daily-rotate-file": "^4.7.1"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.25",
        "@types/jest": "^29.5.12",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/mime-types": "^2.1.4",
        "@types/multer": "^1.4.12",
        "@types/node": "^20.19.43",
        "@types/supertest": "^6.0.2",
        "@types/swagger-ui-express": "^4.1.8",
        "jest": "^29.7.0",
        "supertest": "^6.3.3",
        "ts-jest": "^29.2.5",
        "tsx": "^4.19.0",
        "typescript": "5.6"
    },
    "engines": {
        "node": ">=20"
    }
}
