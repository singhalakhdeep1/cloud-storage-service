# Cloud Storage Service. Copy to .env. Every variable has a safe default except the secrets marked REQUIRED IN
# PRODUCTION. config/env.ts validates them at start-up and refuses weak or missing secrets in production.

# ------------------------------------------------------------------ server
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
# behind nginx / a load balancer: take the client address from X-Forwarded-For
TRUST_PROXY=false
# where browsers reach this API (signed download links point here)
PUBLIC_URL=http://localhost:5000
# browser origins allowed by CORS (comma separated; "*" is refused in production). Share links use the first one.
CLIENT_URL=http://localhost:3097

# ------------------------------------------------------------------ data
MONGODB_URI=mongodb://localhost:27017/file-upload-cloud
# optional: shared cache, rate limits and token revocation across instances (in-process fallback without it)
REDIS_URL=redis://localhost:6379
# or instead of REDIS_URL:
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ------------------------------------------------------------------ auth
# REQUIRED IN PRODUCTION: 32+ characters
JWT_SECRET=
JWT_EXPIRE=7d
# this address becomes an administrator when it registers
ADMIN_EMAIL=
ALLOW_REGISTRATION=true
# bytes per user (5 GB)
DEFAULT_STORAGE_LIMIT=5368709120

# ------------------------------------------------------------------ encryption
# REQUIRED IN PRODUCTION: 64 hex characters (openssl rand -hex 32). Encrypts files at rest (when on),
# integration tokens and webhook secrets.
ENCRYPTION_KEY=
# encrypt every new file at rest (otherwise each user chooses in Settings)
ENCRYPT_AT_REST=false
# signs download/upload links served by this API (derived from JWT_SECRET when unset)
URL_SIGNING_SECRET=

# ------------------------------------------------------------------ storage
# default provider for new files: local | s3 | minio | digitalocean | wasabi | r2 | b2 | gcs | azure
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=uploads

# AWS S3 (AWS_S3_ENDPOINT only for S3-compatible stand-ins)
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# MinIO
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=files

# DigitalOcean Spaces
DO_ENDPOINT=
DO_REGION=nyc3
DO_ACCESS_KEY_ID=
DO_SECRET_ACCESS_KEY=
DO_BUCKET=

# Wasabi
WASABI_ENDPOINT=https://s3.wasabisys.com
WASABI_REGION=us-east-1
WASABI_ACCESS_KEY_ID=
WASABI_SECRET_ACCESS_KEY=
WASABI_BUCKET=

# Cloudflare R2 (R2_ENDPOINT or R2_ACCOUNT_ID)
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Backblaze B2 through its S3-compatible API (application key id + key)
B2_ENDPOINT=
B2_REGION=us-west-004
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=

# Google Cloud Storage (GCS_API_ENDPOINT only for emulators)
GCS_PROJECT_ID=
GCS_KEY_FILENAME=
GCS_BUCKET=
GCS_API_ENDPOINT=

# Azure Blob Storage (connection string, or account + key)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=files

# Presigned URLs for browsers when the provider is reached at another address than the server uses
# (Docker networks): <PREFIX>_PUBLIC_ENDPOINT with PREFIX = AWS_S3 | MINIO | DO | WASABI | R2 | B2
# MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# ------------------------------------------------------------------ uploads
# bytes (100 MB)
MAX_FILE_SIZE=104857600
# largest chunk of a resumable upload (10 MB)
MAX_CHUNK_SIZE=10485760
# real content types accepted (checked from the file's bytes); "*" accepts anything
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,image/avif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,text/plain,text/csv,text/markdown,application/json,application/zip,video/mp4,video/webm,audio/mpeg,audio/wav,audio/ogg
ENABLE_IMAGE_PROCESSING=true
ENABLE_CHUNKED_UPLOAD=true
MAX_FILE_VERSIONS=10
TRASH_RETENTION_DAYS=30
UPLOAD_SESSION_TTL_HOURS=24
ENABLE_JANITOR=true
JANITOR_INTERVAL_SECONDS=300

# ------------------------------------------------------------------ virus scanning (ClamAV clamd over TCP)
ENABLE_VIRUS_SCAN=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# when clamd is unreachable: false = reject uploads (safe), true = accept them unscanned
VIRUS_SCAN_FAIL_OPEN=false

# ------------------------------------------------------------------ CDN
# cloudfront | cloudflare: purges cached copies when files change; CDN_URL is used for public files
CDN_PROVIDER=cloudfront
CDN_URL=
AWS_CLOUDFRONT_DISTRIBUTION=
CLOUDFLARE_API_KEY=
CLOUDFLARE_EMAIL=
CLOUDFLARE_ZONE_ID=

# ------------------------------------------------------------------ integrations and webhooks
# Slack / Dropbox / Google Drive credentials are entered by each user in the app (stored encrypted).
# Endpoint overrides exist for tests only:
# DROPBOX_UPLOAD_URL=https://content.dropboxapi.com/2/files/upload
# GOOGLE_DRIVE_UPLOAD_URL=https://www.googleapis.com/upload/drive/v3/files
# allow webhook targets on private networks (development only; refused in production)
WEBHOOK_ALLOW_PRIVATE=false
# retry delays in ms, comma separated (default 10000,60000,300000: four attempts in all)
WEBHOOK_BACKOFF_MS=

# ------------------------------------------------------------------ rate limiting (token bucket)
RATE_LIMIT_BUCKET_CAPACITY=100
RATE_LIMIT_REFILL_RATE=1

# ------------------------------------------------------------------ monitoring
METRICS_ENABLED=true
# when set, GET /metrics needs "Authorization: Bearer <token>"
METRICS_TOKEN=

# ------------------------------------------------------------------ web app (frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ------------------------------------------------------------------ docker compose
MINIO_ROOT_USER=cloudstorage
MINIO_ROOT_PASSWORD=
# MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# ENCRYPT_AT_REST=false

# ------------------------------------------------------------------ tests
# MONGODB_TEST_URI=mongodb://localhost:27017/file-upload-test
# LOG_IN_TESTS=1
